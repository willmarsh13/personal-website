# Copy to .env (gitignored) and fill in. See README for details.
MONGODB_URI=mongodb+srv://guestbook_app:CHANGE_ME@your-cluster.example.mongodb.net/personal_site?retryWrites=true&w=majority
MONGODB_DB=personal_site
# npm --prefix server run gen-secret
GUESTBOOK_SECRET=
# Number of reverse proxies in front of the container (Cloudflare + nginx = 2, etc.)
TRUST_PROXY=1

# Admin page (/admin). Generate the hash with: npm --prefix server run hash-password
ADMIN_PASSWORD_HASH=
# npm --prefix server run gen-secret
ADMIN_SESSION_SECRET=

# E-ink dashboard (/api/eink). Weather from api.weather.gov.
# EINK_STATION=KATL
# Forecast location; defaults to the station's coordinates.
# EINK_LAT=
# EINK_LON=
# EINK_USER_AGENT=personal-website-eink (https://willmarsh.dev)
# EINK_LOCATION=Atlanta
# EINK_TIMEZONE=America/New_York
# EINK_UNITS=fahrenheit
# Optional: require ?token= on /api/eink
# EINK_TOKEN=
